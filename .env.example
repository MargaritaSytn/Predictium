# Database (PostgreSQL for production)
DB_NAME=predictium
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# PayPal (sandbox for dev, live for prod)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=http://localhost:5173/payment/success
PAYPAL_CANCEL_URL=http://localhost:5173/payment/cancel

# Google Gemini (free tier — for AI prediction hints). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_HINT_MODEL=gemini-2.0-flash
AI_HINT_FREE_LIMIT=2
AI_HINT_PREMIUM_LIMIT=5

# Firebase (FCM push notifications for Android).
# Download service account JSON from Firebase Console → Project Settings → Service accounts
FIREBASE_CREDENTIALS_PATH=
